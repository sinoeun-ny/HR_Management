@{
    ViewData["Title"] = "Department History";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a href="/Department/Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
        <h4 class="mb-0 fw-bold">Department History</h4>
    </div>

    @* Department History Section *@
    <div id="sectionProfile" class="history-section card border-0 shadow-sm rounded-4 p-3 bg-white mb-3">
        <div class="d-flex align-items-center mb-3 text-black">
            <i class="fas fa-history me-2 text-primary"></i>
            <h6 class="fw-bold mb-0">Department Change History</h6>
        </div>
        
        <div class="controls-row mb-3 flex-wrap">
              <div style="position:relative; flex:1; min-width:200px;" class="text-black">
                <input type="text" id="btnSearchEmp" placeholder="Search department name..."
                       style="width:100%; padding-right:36px;">
                <button id="searchClearBtnEmp"
                        style="display:none; position:absolute; right:10px; top:50%; transform:translateY(-50%);
                               background:none; border:none; cursor:pointer; color:#888; font-size:18px;">
                    &#x2715;
                </button>
            </div>
            <button class="search-btn" id="btnDoSearchEmp">Search</button>
            <select id="txtSortByEmp">
                <option value="">Sort by</option>
                <option value="DeptAsc">Ascending</option>
                <option value="DeptDesc">Descending</option>
            </select>
        </div>
        
        <table id="tblEmployeeHistory" class="table table-responsive table-bordered table-hover"></table>
    </div>

    @* Snapshot Modal — shared *@
    <div class="modal fade" id="snapshotModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title" id="snapshotTitle">History Snapshot</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="snapshotBody">
                    <div class="text-center py-4">
                        <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/Department/departmentHistory.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/Department/departmentHistory.js"></script>
}