@{
    ViewData["Title"] = "Payroll";
}

<div class="container">
    <div class="header">Payroll</div>

    <div class="card-container1">

        <!-- Card 1: Generate Finance Report with Toggle -->
        <div class="card1">
            <div class="card-header1">
                <i class="fas fa-lightbulb icon-report"></i>
                <h3>Generate Finance Report</h3>
            </div>
            <div class="card-footer1">
                <div style="display:flex;background:rgba(255,255,255,0.2);border-radius:8px;overflow:hidden;margin-top:8px;">
                    <button id="empToggleBtn" onclick="switchView('employee')"
                            style="flex:1;padding:8px 0;font-size:13px;font-weight:600;border:none;cursor:pointer;background:#fff;color:#2979FF;transition:all .15s;">
                        <i class="fas fa-users"></i> Employee
                    </button>
                    <button id="deptToggleBtn" onclick="switchView('department')"
                            style="flex:1;padding:8px 0;font-size:13px;font-weight:600;border:none;cursor:pointer;background:transparent;color:rgba(255,255,255,0.85);transition:all .15s;">
                        <i class="fas fa-building"></i> Department
                    </button>
                </div>
            </div>
        </div>

        <!-- Card 2: Monthly Payroll -->
        <div class="card1">
            <div class="card-header1">
                <i class="fas fa-dollar-sign icon-payroll"></i>
                <h3>Monthly Payroll</h3>
            </div>
            <div class="card-body text-center">
                <p id="monthlyPayroll" class="amount">$0.00</p>
                <span id="payrollPercent" class="pill pill-red">0.00% of total</span>
            </div>
        </div>

        <!-- Card 3: Departments -->
        <div class="card1">
            <div class="card-header1">
                <i class="fas fa-building icon-company"></i>
                <h3>Departments</h3>
            </div>
            <div class="card-body text-center">
                <p id="deptActiveCount" class="amount">0 active</p>
                <span id="deptPaidLabel" class="pill pill-green">0 of 0 paid</span>
            </div>
        </div>

    </div>

    <!-- Search Bar: Employee View -->
    <div class="toolbar d-flex flex-wrap align-items-center justify-content-between mb-3 gap-3" id="empSearchBar">
        <div class="flex-grow-1 position-relative">
            <input type="text" id="searchInput" class="form-control ps-3 pe-5"
                   placeholder="Search by Employee ID or Name..." onkeyup="filterTable()">
            <button id="clearBtn" type="button"
                    class="btn position-absolute top-50 end-0 translate-middle-y me-2 p-0 border-0 bg-transparent d-none"
                    onclick="clearSearch()">
                <i class="fas fa-times text-secondary"></i>
            </button>
        </div>

        <!-- CHANGED: native <select> instead of a Bootstrap dropdown -->
        <select id="statusSelect" class="form-select" style="max-width:170px;" onchange="setFilter(this.value)">
            <option value="">All</option>
            <option value="paid">Paid</option>
            <option value="pending">Pending</option>
            @* <option value="unpaid">Unpaid</option> *@
            <option value="Paid Early">Paid Early</option>

        </select>

        <button class="btn btn-primary" onclick="filterTable()">Search</button>
    </div>

    <!-- Search Bar: Department View -->
    <div class="toolbar d-flex flex-wrap align-items-center justify-content-between mb-3 gap-3"
         id="deptSearchBar" style="display:none !important">
        <div class="flex-grow-1 position-relative">
            <input type="text" id="deptSearchInput" class="form-control ps-3"
                   placeholder="Search by Department Name..." onkeyup="filterDeptTable()">
        </div>
        <select id="deptStatusSelect" class="form-select" style="max-width:170px;" onchange="setDeptFilter(this.value)">
            <option value="">All</option>
            <option value="paid">Paid</option>
            <option value="pending">Pending</option>
            <option value="Partial">Partial</option>
        </select>


        <button class="btn btn-primary" onclick="filterDeptTable()">Search</button>
    </div>

</div>




<!-- Employee Table -->
<div class="table-responsive shadow-sm rounded-0" id="employeeTableWrap">
    <table id="payrollTable" class="table table-striped table-hover align-middle mb-0">
        <thead class="table-bordered table-hover">
            <tr>
                <th>Employee ID</th>
                <th>Employee Name</th>
                <th>Department</th>
                <th>Position</th>
                <th>Pay Date</th>
                <th>Net Salary</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>




<!-- Department Table -->
<div class="table-responsive shadow-sm rounded-0" id="deptTableWrap" style="display:none">
    <table id="deptTable" class="table table-striped table-hover align-middle mb-0">
        <thead class="table-bordered table-hover">
            <tr>
                <th>Department</th>
                <th>Employees</th>
                <th>Total Salary</th>
                <th>Period Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="deptTableBody"></tbody>
    </table>
</div>




<!-- ── Pay Now Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title">
                    <i class="fas fa-money-bill-wave me-2"></i>Pay Now
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <input type="hidden" id="editTransactionId" />
                    <input type="hidden" id="editEmployeeId" />

                    <!-- Employee Info (readonly) -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted small">Employee Name</label>
                        <input type="text" id="editEmployeeName" class="form-control" readonly />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted small">Position</label>
                        <input type="text" id="editPosition" class="form-control" readonly />
                    </div>

                    <hr class="my-1" />

                    <!-- Salary Fields -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Gross Salary ($)</label>
                        <input type="number" id="editGrossSalary" class="form-control" step="0.01" min="0" placeholder="0.00" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tax Deductions ($)</label>
                        <input type="number" id="editTaxDeductions" class="form-control" step="0.01" min="0" placeholder="0.00"
                               oninput="autoCalcNet()" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Net Salary ($)</label>
                        <input type="number" id="editNetSalary" class="form-control" step="0.01" min="0" placeholder="0.00" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <select id="editStatus" class="form-select">
                            <option value="Paid">Paid</option>
                            <option value="Pending">Pending</option>
                            @* <option value="Unpaid">Unpaid</option> *@
                        </select>
                    </div>

                    <!-- Pay Date — shown when status = Paid -->
                    <div class="col-12 d-none" id="editPayDateWrapper">
                        <label class="form-label fw-semibold">Pay Date</label>
                        <input type="date" id="editPayDate" class="form-control" readonly />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea id="editNotes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button class="btn btn-success" onclick="saveEditChanges()">
                    <i class="fas fa-money-bill-wave me-1"></i>Pay Now
                </button>
            </div>
        </div>
    </div>
</div>




<!-- View Slip Moda -->
<div class="modal fade" id="viewSlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content  border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-file-invoice-dollar me-2"></i>Payroll Slip</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-2 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Employee ID</label>
                        <input type="text" id="slipEmployeeId" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Employee Name</label>
                        <input type="text" id="slipEmployeeName" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Position</label>
                        <input type="text" id="slipPosition" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Department</label>
                        <input type="text" id="slipDepartment" class="form-control" readonly />
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-bordered table-hover">
                            <tr>
                                <th>Transaction ID</th>
                                <th>Period Date</th>
                                <th>Pay Date</th>
                                <th>Salary</th>
                                <th>Status</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody id="slipTableBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Payroll/payroll.js"></script>
}

