@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isEmployee = string.Equals(currentController, "Employee", StringComparison.OrdinalIgnoreCase);
    var isDepartment = string.Equals(currentController, "Department", StringComparison.OrdinalIgnoreCase);
    var isPayroll = string.Equals(currentController, "Payroll", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Management</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Bootstrap Table CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.22.4/bootstrap-table.min.css" />

    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/11.10.6/sweetalert2.min.css" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Project Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/dashboard/style.css" />
    <link rel="stylesheet" href="~/css/Dashboard/Dashboard.css" />
    <link rel="stylesheet" href="~/css/payroll/payroll.css" />
    <link rel="stylesheet" href="~/css/payroll/Style1.css" />
    <link rel="stylesheet" href="~/css/employee/employee.css" />
    <link rel="stylesheet" href="~/css/Department/department.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="w-screen h-screen bg-gray-50 overflow-hidden font-poppins">

    <div class="flex w-screen h-screen">
        <!-- Sidebar Navigation -->
        <aside class="fixed top-0 left-0 h-screen w-[280px] p-3 z-30">
            <div class="relative flex h-full w-full flex-col rounded-2xl bg-blue-600 p-4 text-slate-200 shadow-xl">

                <div class="p-3 mb-2 text-center border-b border-blue-500/50">
                    <img src="~/image/ghibil.webp" alt="Company Logo"
                         class="mx-auto mb-2 w-14 h-14 object-contain rounded-full shadow-md bg-white/10"
                         onerror="this.src='https://ui-avatars.com/api/?name=HR+System&background=0D8ABC&color=fff';" />
                    <h5 class="text-lg font-semibold text-white tracking-wide">
                        HR Management
                    </h5>
                    <p class="text-xs text-blue-100/80 truncate">phearunphoeun@gmail.com</p>
                </div>

                <nav class="flex flex-col gap-1.5 font-sans text-sm font-medium text-white h-full mt-2">
                    <!-- Employee Profile -->
                    <div class="w-full">
                        <a asp-area="" asp-controller="Employee" asp-action="Index"
                           class="flex items-center w-full px-3.5 py-2.5 rounded-xl transition-all duration-150 @(isEmployee ? "bg-white text-blue-600 shadow-sm font-semibold" : "text-white/90 hover:bg-white/15 hover:text-white")">
                            <div class="w-7 grid place-items-center mr-3">
                                <i class="fas fa-users text-base"></i>
                            </div>
                            <span>Employee Profile</span>
                        </a>
                    </div>

                    <!-- Department -->
                    <div class="w-full">
                        <a asp-area="" asp-controller="Department" asp-action="Index"
                           class="flex items-center w-full px-3.5 py-2.5 rounded-xl transition-all duration-150 @(isDepartment ? "bg-white text-blue-600 shadow-sm font-semibold" : "text-white/90 hover:bg-white/15 hover:text-white")">
                            <div class="w-7 grid place-items-center mr-3">
                                <i class="fas fa-building text-base"></i>
                            </div>
                            <span>Department</span>
                        </a>
                    </div>

                    <!-- Payroll -->
                    <div class="w-full">
                        <a asp-area="" asp-controller="Payroll" asp-action="Index"
                           class="flex items-center w-full px-3.5 py-2.5 rounded-xl transition-all duration-150 @(isPayroll ? "bg-white text-blue-600 shadow-sm font-semibold" : "text-white/90 hover:bg-white/15 hover:text-white")">
                            <div class="w-7 grid place-items-center mr-3">
                                <i class="fas fa-money-check-alt text-base"></i>
                            </div>
                            <span>Payroll</span>
                        </a>
                    </div>

                    <div class="flex-grow"></div>

                    <!-- Logout -->
                    <div class="w-full pt-2 border-t border-blue-500/50">
                        <a asp-area="" asp-controller="Login" asp-action="Index"
                           class="flex items-center w-full px-3.5 py-2.5 rounded-xl text-red-200 hover:bg-red-500 hover:text-white transition-all duration-150">
                            <div class="w-7 grid place-items-center mr-3">
                                <i class="fas fa-sign-out-alt text-base"></i>
                            </div>
                            <span>Logout</span>
                        </a>
                    </div>
                </nav>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="content-container flex-1 ml-[280px] p-4 overflow-y-auto h-screen">
            <main role="main" class="w-full h-full pb-10">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Core Vendor Libraries (loaded once in correct dependency sequence) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.22.4/bootstrap-table.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/11.10.6/sweetalert2.all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Page Specific Scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
