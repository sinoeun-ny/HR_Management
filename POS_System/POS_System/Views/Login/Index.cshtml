@model POS_System.Models.UserLoginModel;
@{
    ViewData["Title"] = "Login Page";
    Layout = null;
}

<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- Custom CSS (optional, if you have styles) -->
<link href="~/css/login/style.css" rel="stylesheet">

<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="bg-white shadow-lg rounded-lg flex overflow-hidden w-full max-w-4xl">

        <!-- Image Column -->
        <div class="w-1/2 hidden md:block">
            <img src="/image/login.jpg" alt="Login" class="h-full w-full object-cover">
        </div>

        <!-- Form Column -->
        <div class="w-full md:w-1/2 p-8">
            <h2 class="text-3xl font-bold text-center mb-6">Login</h2>

            @if (ViewData["Error"] != null)
            {
                <p class="text-red-500 text-center">@ViewData["Error"]</p>
            }
            

            <form asp-action="Index" method="POST">
                <div class="mb-4">
                    <label for="PhoneNumber" class="sr-only">Email</label>
                    <input type="text" id="Email" name="Email" class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter your email" required value="@Model.Email">
                </div>
                <div class="mb-4">
                    <label for="Password" class="sr-only">Password</label>
                    <input type="password" id="Password" name="Password" class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter your password" required value="@Model.Password">
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded hover:bg-blue-500 transition">Login</button>
            </form>
        </div>
    </div>
</div>
