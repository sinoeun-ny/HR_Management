@{
    ViewData["Title"] = "Employee Analytics";
}

<div class="container-fluid py-4 ">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a href="/Employee/Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
        <h4 class="mb-0 fw-bold">Employee Analytics</h4>
    </div>

    @* Summary Cards *@
    <div class="row g-3 mb-4 bg-#e5e7eb text-white" >
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold fs-2 " id="cardActive">---</div>
                <div class="small">Active Employees</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold fs-2 " id="cardInactive">---</div>
                <div class=" small">Inactive Employees</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold fs-2 " id="cardTotal">---</div>
                <div class="small">Total Employees</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold fs-2 " id="cardNewHires">---</div>
                <div class="small">New Hires This Year</div>
            </div>
        </div>
    </div>

    @* Charts Row *@
    <div class="row g-4 mb-4 ">
        @* Doughnut *@
        <div  class="col-md-4 ">
            <div id="donutChart" class="card border-1 shadow-sm rounded-4 p-3 h-100 bg-white text-black">
                <h6 class="fw-bold mb-3"><i class="fas fa-circle-half-stroke me-2 text-primary"></i>Active vs Inactive</h6>
                <div style="position:relative; height:260px;">
                    <canvas id="chartTotalEmployees"></canvas>
                </div>
            </div>
        </div>

        @* New Hires Bar *@
        <div class="col-md-8">
            <div id="newHire"class="card border-1 shadow-sm rounded-4 p-3 h-100 bg-white text-black">
                <h6 class="fw-bold mb-3"><i class="fas fa-user-plus me-2 text-primary"></i>New Hires by Department</h6>
                <div style="position:relative; height:260px;">
                    <canvas id="chartNewHires"></canvas>
                </div>
            </div>
        </div>
    </div>
    @* Employee Table *@
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
        <h6 class="fw-bold mb-3 text-black">
            <i class="fas fa-table me-2 "></i>
            All Employees
        </h6>
        <div class="controls-row">
            <div style="position:relative; flex:1; min-width:200px;">
                <input type="text" class="text-black" id="btnSearchAll" placeholder="Search employee id or name..."
                       style="width:100%; padding-right:36px;">
                <button id="searchClearBtnAll"
                        style="display:none; position:absolute; right:10px; top:50%; transform:translateY(-50%);
                           background:none; border:none; cursor:pointer; color:#888; font-size:18px; line-height:1;"
                        title="Clear">
                    &#x2715;
                </button>
            </div>
            <button class="bg-primary text-white search-btn-all">Search</button>
            <select id="txtSortByAll">
                <option value="" >Sort by</option>
                <option value="Descending">Descending</option>
                <option value="Ascending">Ascending</option>
            </select>
            <select id="txtSortByStatus" >
                <option value="" >Filter Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    <div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title" id="exampleModalLabel">+ New Employee Profile</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active text-dark" id="EmployeeID" data-bs-toggle="tab"
                                    data-bs-target="#EmployeeInfo" type="button" role="tab">
                                Employee Info
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-dark" id="employee-position-tab" data-bs-toggle="tab"
                                    data-bs-target="#EmployeePosition" type="button" role="tab">
                                Employee Position
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-dark" id="document-storage-tab" data-bs-toggle="tab"
                                    data-bs-target="#DocumentStorage" type="button" role="tab">
                                Document Storage
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">

                        @* Tab: Employee Info *@
                        <div class="tab-pane fade show active" id="EmployeeInfo" role="tabpanel">
                            <div class="modal-body row g-3">
                                <input type="hidden" id="EmployeeId" value="0">
                                <div class="col-md-9">
                                    <label class="form-label">Profile Photo / File</label>
                                    <div id="imagePreview">
                                        <span>Click to upload</span>
                                        <button type="button" id="removeImage">x</button>
                                    </div>
                                    <input type="file" id="ProfilePhoto" accept="image/*" style="display:none;" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">First Name</label>
                                    <input type="text" class="form-control" placeholder="Input your Firstname" id="txtFirstName" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Last Name</label>
                                    <input type="text" class="form-control" placeholder="Input your Lastname" id="txtLastName" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Gender</label>
                                    <select class="form-select" id="Gender" required>
                                        <option value="" selected disabled>Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Date of Birth</label>
                                    <input type="date" class="form-control" id="dateOfBirth" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="text" class="form-control" id="txtEmail" placeholder="Input Email" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Phone Number</label>
                                    <input type="text" class="form-control" id="PhoneNumber" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Address</label>
                                    <input type="text" class="form-control" id="txtAddress" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Hire Date</label>
                                    <input type="date" class="form-control" id="HireDate" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Status</label>
                                    <select class="form-select" id="Status" required>
                                        <option value="" selected disabled>Select status</option>
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        @* Tab: Position *@
                        <div class="tab-pane fade" id="EmployeePosition" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Department</label>
                                    <select class="form-select" id="DepartmentId" required>
                                        <option value="" selected disabled>Select Department</option>
                                        <option value="1">Information Technology</option>
                                        <option value="2">Finance and Banking</option>
                                        <option value="3">Human Resource</option>
                                        <option value="4">Marketing and Sales</option>
                                        <option value="5">Operations Management</option>
                                        <option value="6">Customer Service</option>
                                        <option value="7">Research and Development</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Start Date</label>
                                    <input type="date" id="StartDate" class="form-control">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Position</label>
                                    <select class="form-select" id="txtPositionName" required>
                                        <option value="" selected disabled>Select Position</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">End Date</label>
                                    <input type="date" id="EndDate" class="form-control">
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Salary</label>
                                    <input type="text" class="form-control" id="txtSalary" placeholder="Enter Employee Salary">
                                </div>
                                <div class="col-md-12" id="txtUpdatePromote" style="display:none;">
                                    <label class="form-label">Update Option</label>
                                    <select class="form-select" id="txtUpdate">
                                        <option value="" selected disabled></option>
                                        <option value="Update">Update</option>
                                        <option value="Promote">Promote</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        @* Tab: Documents *@
                        <div class="tab-pane fade" id="DocumentStorage" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Document Name</label>
                                    <input type="text" class="form-control" id="txtDocumentName">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Expiry Date</label>
                                    <input type="date" class="form-control" id="txtExpiryDate">
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Notes</label>
                                    <input type="text" class="form-control" id="txtNotes">
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Upload Documents</label>
                                    <input class="form-control" type="file" accept=".pdf,.jpg,.png"
                                           id="txtDocumentType" multiple>
                                    <small class="text-muted">Hold Ctrl/Cmd to select multiple files.</small>
                                    <div id="documentPreviewArea" class="mt-3"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
        <table id="tblAllEmployeeInfo" class="table table-responsive table-bordered"></table>
  <</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.22.4/bootstrap-table.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.22.4/bootstrap-table.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/11.10.6/sweetalert2.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<link href="~/css/employee/AllEmp.css" rel="stylesheet" />
<script src="~/js/Ajaxs/ajaxHelper.js"></script>
<script src="~/js/Employee/employeeAll.js"></script>

