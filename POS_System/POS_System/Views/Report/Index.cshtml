                <div class="d-flex align-items-center w-100">
                    <div class="ms-3 icon">
                        <i class="bi bi-bar-chart-line" style="font-size: 2.5rem;"></i>
                    </div>

                    <div class="ms-3">
                        <h6 class="fw-bold mb-1" style="font-size: 1.1rem;">Inventory</h6>
                        <p class="mb-1" style="font-size: 0.85rem;">Top Product</p>
                        <h4 class="fw-bold mb-0" style="font-size: 1.2rem;">Dairy product</h4>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-md-3" id="all_report">
            <div class="card text-white d-flex align-items-center justify-content-center p-3 border-0 shadow-lg"
                 style="background-color: #007bff; border-radius: 15px;">

                <div class="d-flex align-items-center w-100">
                    <div class="ms-3 icon">
                        <i class="fas fa-boxes" style="font-size: 2.5rem;"></i>
                    </div>

                    <div class="ms-3">
                        <h6 class="fw-bold mb-1" style="font-size: 1.1rem;">Product</h6>
                        <p class="mb-1" style="font-size: 0.85rem;">Today</p>
                        <h4 class="fw-bold mb-0" style="font-size: 1.2rem;">20</h4>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-md-3" id="all_report">
            <div class="card text-white d-flex align-items-center justify-content-center p-3 border-0 shadow-lg"
                 style="background-color: #007bff; border-radius: 15px;">

                <div class="d-flex align-items-center w-100">
                    <div class="ms-3 icon">
                        <i class="fas fa-credit-card" style="font-size: 2.5rem;"></i>
                    </div>

                    <div class="ms-3">
                        <h6 class="fw-bold mb-1" style="font-size: 1.1rem;">Supplier</h6>
                        <p class="mb-1" style="font-size: 0.85rem;">BenBen</p>
                        <h4 class="fw-bold mb-0" style="font-size: 1.2rem;">KPC</h4>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<form action="/" method="post">
    <div class="position-relative mt-5" style="width: 400px;">
        <!-- Search Input -->
        <input id="search"
               class="form-control bg-white border border-primary rounded-2 ps-5"
               placeholder="Search for something..."
               style="width: 100%; height: 42px; font-size: 16px;">
    </div>
</form>



<div class="container mt-3 containerbutton"
     style="box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15); border-radius: 15px; padding: 10px; width: 588px; background-color: white;">
    <div class="d-flex gap-3">
        <a asp-controller="report" asp-action="Index" class="btn btn-primary p-2 text-white" role="button">
            Expense
        </a>
        <a asp-controller="report" asp-action="Inventory" class="btn btn-outline-primary p-2" role="button">
            Inventory
        </a>
        <a asp-controller="report" asp-action="Product" class="btn btn-outline-primary p-2" role="button">
            Product
        </a>
        <a asp-controller="report" asp-action="Supplier" class="btn btn-outline-primary p-2" role="button">
            Supplier
        </a>
    </div>
</div>


