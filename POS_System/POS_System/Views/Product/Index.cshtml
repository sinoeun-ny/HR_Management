@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Title"] = "Product";
}

<div class="container-md mt-3">
    <div class="row" style="margin-bottom: 10px;">
        <div class="col-md-9 fs-1 fw-bold text-dark">
            <h3>Product Management</h3>
        </div>
        <div id="icons-product" class="col-md-3  flex text-end justify-content-end">
            <div class="notification-wrapper">
                <span class="bi--bell-fill"></span>
                <div class="notification-badge"></div>
            </div>
        </div>
    </div>

    <!-- Top Row: Product Status & Buttons -->
    <div class="row g-4 mb-3 align-items-stretch">
        <!-- Product Status -->
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm rounded border h-100">
                <h5 class="fw-bold text-primary">Product status</h5>
                <div class="d-flex justify-content-between mt-3">
                    <div>
                        <h6 class="text-secondary">Product</h6>
                        <p class="fs-4 fw-bold">124 <span class="fs-6 fw-normal">items</span></p>
                    </div>
                    <div>
                        <h6 class="text-secondary">Category</h6>
                        <p class="fs-4 fw-bold">140 <span class="fs-6 fw-normal">types</span></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="col-md-8">
            <div class="d-flex flex-column justify-content-between h-100 bg-white shadow-sm rounded border p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <a asp-controller="Product" asp-action="ManageProduct">
                            <button class="btn btn-lg btn-primary w-100">
                                <i class="bi bi-bag-fill me-1"></i> Manage product
                            </button>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Product" asp-action="SupplierProduct">
                            <button class="btn btn-lg btn-primary w-100">
                                <i class="bi bi-bag-fill me-1"></i> Supplier product
                            </button>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Product" asp-action="ManageCategory">
                            <button class="btn btn-lg btn-primary w-100">
                                <i class="bi bi-tags-fill me-1"></i> Manage category
                            </button>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Product" asp-action="ManageLogistic">
                            <button class="btn btn-lg btn-primary w-100">
                                <i class="bi bi-bag-fill me-1"></i> Manage logistic
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Middle Row: Chart & Expire Alert -->
    <div class="row g-4 mb-4">
        <!-- Pie Chart -->
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm rounded border h-100">
                <h5 class="fw-bold text-primary">Category product</h5>
                <div class="d-flex justify-content-center align-items-center h-100">
                    <div id="pie-chart" style="width: 250px; height: 250px; margin-left: -40px;"></div>
                </div>
            </div>
        </div>

        <!-- Expire Alert -->
        <div class="col-md-8">
            <div class="p-3 bg-white shadow-sm rounded border h-100">
                <h5 class="fw-bold text-danger mb-3">Expire alert</h5>
                <div class="overflow-auto" style="max-height:300px;">
                    <table class="table table-sm mt-3">
                        @* <thead class="table-light sticky-top"> *@
                        @*     <tr> *@
                        @*         <th>Product Name</th> *@
                        @*         <th>SKU</th> *@
                        @*         <th>Expiration Date</th> *@
                        @*         <th>Days Remaining</th> *@
                        @*         <th>Stock</th> *@
                        @*     </tr> *@
                        @* </thead> *@
                        <tbody>
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50 sticky top-0 z-10">
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">SKU</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expiration Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Days Remaining</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    <tr class="bg-white">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Milk 2% 1L</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">MLK-001</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-03-15</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600">5 days</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">25 units</td>
                                    </tr>
                                    <tr class="bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Fresh Bread</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">BRD-002</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-03-13</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600">3 days</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">15 units</td>
                                    </tr>
                                    <tr class="bg-white">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Yogurt Pack</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">YOG-003</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-03-17</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-orange-600">7 days</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">30 units</td>
                                    </tr>
                                    <tr class="bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Cheese Slices</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">CHS-004</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-03-12</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600">2 days</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">10 units</td>
                                    </tr>
                                    <tr class="bg-white">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Eggs 12-pack</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">EGG-005</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-03-16</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600">6 days</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">20 units</td>
                                    </tr>
                                    <tr class="bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Butter 250g</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">BTR-006</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-03-14</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600">4 days</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">35 units</td>
                                    </tr>
                                </tbody>
                            </table>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <!-- Bottom Row: Quick Alerts -->

    <div class="row g-3">
        <h5 class="fw-bold text-primary">Quick Alert</h5>
        <div class="col-md-12">
            <div class="p-3 bg-white shadow-sm rounded border d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="bi bi-envelope-fill text-primary fs-4 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-0 fs-6">Product Expired</h6>
                        <small class="text-muted">Product: P001 has been expired please remove</small>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-primary rounded-pill">View detail</button>
            </div>
        </div>

        <div class="col-md-12">
            <div class="p-3 bg-white shadow-sm rounded border d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="bi bi-envelope-fill text-primary fs-4 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-0 fs-6">New product</h6>
                        <small class="text-muted">Product: P002 has been added</small>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-primary rounded-pill">View detail</button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="~/js/Product/Product.js"></script>




