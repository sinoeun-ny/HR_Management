    <!-- Overlay and Form Pop-up -->
    <div class="overlay" id="overlay"></div>
    <div class="form-container" id="formContainer">
        <h2 class="fs-1 fw-bold">Setting</h2>
        <!-- Row 1: Name | Hire date -->
        <div class="form-row">
            <div class="form-column">
                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" id="name">
                </div>
            </div>
            <div class="form-column">
                <div class="form-group">
                    <label for="hireDate">Hire date</label>
                    <input type="text" id="hireDate">
                </div>
            </div>
        </div>
        <!-- Row 2: Role | emialo -->
        <div class="form-row">
            <div class="form-column">
                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role">
                        <option value="Cashier">Cashier</option>
                        <option value="Admin">Admin</option>
                        <option value="Checker">Checker</option>
                    </select>
                </div>
            </div>
            <div class="form-column">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email">
                </div>
            </div>
        </div>
        <!-- Row 3: Status | Password -->
        <div class="form-row">
            <div class="form-column">
                <div class="form-group">
                    <label for="status">Status</label>
                    <select id="status">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="form-column">
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password">
                </div>
            </div>
        </div>
        <!-- Row 4: Store | Update | Delete -->
        <div class="store-row">
            <div class="store-column">
                <div class="form-group">
                    <label for="store">Store</label>
                    <input type="text" id="store">
                </div>
            </div>
            <div class="buttons-column">
                <button class="update-btn" onclick="updateForm()">Update</button>
                <button class="delete-btn" onclick="deleteForm()">Delete</button>
            </div>
        </div>
    </div>

